{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "may-reels/lich.schema.json",
  "title": "Lịch tuần và mùa (brand/<kênh>/lich.yaml)",
  "type": "object",
  "required": ["phien_ban", "tuan", "mua"],
  "additionalProperties": false,
  "$defs": {
    "trang_thai": {"enum": ["gia_thuyet", "da_xac_nhan"]},
    "ngay": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "tang": {"enum": ["keo_xem", "niem_tin", "chuyen_doi"]}
  },
  "properties": {
    "phien_ban": {"const": 1},
    "tuan": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["thu", "tang", "dinh_dang", "trang_thai", "ngay_cap_nhat"],
        "additionalProperties": false,
        "properties": {
          "thu": {"type": "integer", "minimum": 2, "maximum": 8, "description": "2 = thứ Hai ... 8 = Chủ Nhật"},
          "tang": {"$ref": "#/$defs/tang"},
          "dinh_dang": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "ghi_chu": {"type": "string"},
          "trang_thai": {"$ref": "#/$defs/trang_thai"},
          "ngay_cap_nhat": {"$ref": "#/$defs/ngay"}
        }
      }
    },
    "mua": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ma", "ten", "tu_ngay", "den_ngay", "nhom", "goc", "trang_thai", "ngay_cap_nhat"],
        "additionalProperties": false,
        "properties": {
          "ma": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "ten": {"type": "string"},
          "tu_ngay": {"$ref": "#/$defs/ngay"},
          "den_ngay": {"$ref": "#/$defs/ngay"},
          "nhom": {"type": "array", "items": {"type": "string", "pattern": "^n\\d+$"}},
          "goc": {"type": "string"},
          "dieu_kien_duoc_noi": {"type": "array", "items": {"type": "string"}},
          "theo_su_kien": {
            "type": "object",
            "description": "Mùa không có ngày cố định: chạy từ truoc_ngay ngày trước đến sau_ngay ngày sau mốc. Khi có khóa này, tu_ngay/den_ngay để null.",
            "required": ["moc", "truoc_ngay", "sau_ngay"],
            "additionalProperties": false,
            "properties": {
              "moc": {"type": "string"},
              "truoc_ngay": {"type": "integer", "minimum": 0},
              "sau_ngay": {"type": "integer", "minimum": 0}
            }
          },
          "trang_thai": {"$ref": "#/$defs/trang_thai"},
          "ngay_cap_nhat": {"$ref": "#/$defs/ngay"}
        }
      }
    },
    "mua_dang_chay": {"type": ["string", "null"]}
  }
}
