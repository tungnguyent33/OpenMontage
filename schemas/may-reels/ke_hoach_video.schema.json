{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "may-reels/ke_hoach_video.schema.json",
  "title": "KeHoachVideo",
  "description": "Phần SÁNG TẠO của một video Máy Reels, do agent viết theo skills/may-reels/san-xuat-khong-hoi.md. Mọi bước dựng sau đó là Python tất định (may_reels/dung/). Kiểm tra nội dung (cụm từ cấm, nguồn luật, cảnh, nhịp) nằm ở may_reels/dung/ke_hoach.py.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "hook": {
      "type": "object", "additionalProperties": false, "required": ["cong_thuc", "hinh_0_3s", "cau_noi", "chu_man_hinh"],
      "properties": {
        "cong_thuc": {"type": "string", "minLength": 1, "description": "Mã công thức trong brand/<kenh>/hook.yaml"},
        "hinh_0_3s": {"type": "string", "minLength": 5, "description": "Hình 0-3 giây"},
        "cau_noi": {"type": "string", "minLength": 2, "description": "Câu nói đầu"},
        "chu_man_hinh": {"type": "string", "minLength": 2, "description": "Chữ trên màn hình, dạng 'DÒNG 1 / dòng 2'"}
      }
    }
  },
  "required": ["phien_ban", "ma_video", "kenh", "ma_chu_de", "tieu_de", "khung_nhip", "nguon_luat", "doan", "caption", "thieu_canh", "quyet_dinh"],
  "properties": {
    "phien_ban": {"const": 1},
    "ma_video": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "kenh": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "ma_chu_de": {"type": "string", "minLength": 1},
    "tieu_de": {"type": "string", "minLength": 1, "maxLength": 100, "description": "Dòng đầu caption và tiêu đề YouTube"},
    "khung_nhip": {"type": "string", "description": "Khóa trong san-xuat.yaml khung_nhip"},
    "nguon_luat": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "van_ban", "ten_ngan", "dieu_khoan", "link", "ngay_mo", "trich_nguyen_van"],
        "properties": {
          "id": {"type": "string", "pattern": "^n[0-9]+$"},
          "van_ban": {"type": "string", "minLength": 1},
          "ten_ngan": {"type": "string", "minLength": 1, "description": "Dòng nguồn trên màn hình, ví dụ 'Luật 36/2024/QH15'"},
          "dieu_khoan": {"type": "string", "minLength": 1},
          "link": {"type": "string", "pattern": "^https?://"},
          "ngay_mo": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "trich_nguyen_van": {"type": "string", "minLength": 10}
        }
      }
    },
    "doan": {
      "type": "array", "minItems": 4, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "vai", "loi", "nguon_ids", "the", "canh"],
        "properties": {
          "id": {"type": "string", "pattern": "^s[0-9]+$"},
          "vai": {"enum": ["hook", "than", "chot", "cta"]},
          "loi": {"type": "string", "minLength": 2, "description": "Lời đọc = phụ đề, đúng chính tả, số viết bằng chữ số"},
          "doc_rieng": {"type": "string", "description": "Cách đọc riêng cho TTS nếu khác lời (hiếm khi cần)"},
          "nguon_ids": {"type": "array", "items": {"type": "string"}},
          "the": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "additionalProperties": false, "required": ["dong1", "dong2", "mau", "kieu"],
               "properties": {"dong1": {"type": "string", "minLength": 1, "maxLength": 22},
                              "dong2": {"type": "string", "minLength": 1, "maxLength": 34},
                              "mau": {"enum": ["cam", "xanh"]},
                              "kieu": {"enum": ["hook", "wipe", "word", "scale"]}}}
            ]
          },
          "canh": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "additionalProperties": false, "required": ["ma", "mo_ta"],
               "properties": {"ma": {"type": "string"}, "vao": {"type": ["number", "null"], "minimum": 0},
                              "mo_ta": {"type": "string"}, "ly_do_chon": {"type": "string"}}},
              {"type": "object", "additionalProperties": false, "required": ["so_do", "mo_ta"],
               "description": "CẢNH TẠM (B-roll sơ đồ động) cho đoạn có trong thieu_canh; thay bằng cảnh quay thật sau (lệnh thay-canh).",
               "properties": {
                 "mo_ta": {"type": "string"},
                 "so_do": {
                   "type": "object", "additionalProperties": false, "required": ["kieu"],
                   "properties": {
                     "kieu": {"enum": ["giao_nhau", "vong_xuyen", "the_chu"]},
                     "xe": {"type": "array", "maxItems": 4, "items": {
                       "type": "object", "additionalProperties": false, "required": ["tu", "thu_tu"],
                       "properties": {"tu": {"enum": ["duoi", "tren", "trai", "phai"]},
                                      "thu_tu": {"type": "integer", "minimum": 1, "maximum": 4},
                                      "loai": {"enum": ["xe_may", "o_to", "uu_tien"]}}}},
                     "duong_uu_tien": {"enum": ["ngang", "doc"]},
                     "nhan": {"type": "string", "maxLength": 40, "description": "Dòng chú thích dưới sơ đồ"},
                     "chu": {"type": "string", "maxLength": 60, "description": "Chữ lớn cho kiểu the_chu"}
                   }
                 }
               }}
            ]
          }
        }
      }
    },
    "caption": {
      "type": "object", "additionalProperties": false, "required": ["fb_reels", "yt_shorts", "tiktok"],
      "properties": {"fb_reels": {"type": "string", "minLength": 10}, "yt_shorts": {"type": "string", "minLength": 10},
                     "tiktok": {"type": "string", "minLength": 10}}
    },
    "thieu_canh": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["doan", "y_can_canh", "mo_ta_canh", "goi_y_quay", "ly_do"],
                "properties": {"doan": {"type": "string"}, "y_can_canh": {"type": "string"}, "mo_ta_canh": {"type": "string"},
                               "goi_y_quay": {"type": "string"}, "ly_do": {"type": "string"}}}
    },
    "kich_ban": {
      "type": "object", "additionalProperties": false,
      "description": "Quy trình viết lời (skills/may-reels/bien-kich.md, C2b). Không bắt buộc với kế hoạch cũ; san-xuat bắt buộc (may_reels/bien_tap.py kiểm). Biên tập KHÔNG đọc phần này.",
      "required": ["nhom_doi_tuong", "noi_lo", "nguon_noi_lo", "dinh_dang", "goc_ke", "goc_chon", "ly_do_goc",
                   "hook_chon", "ly_do_hook", "phuong_an_hook", "ban_1", "sua_ban_2"],
      "properties": {
        "nhom_doi_tuong": {"type": "string", "minLength": 1, "description": "Mã nhóm trong doi-tuong.yaml (n1..n5), hoặc 'moi_nhom'"},
        "noi_lo": {"type": "string", "minLength": 3, "description": "Nỗi lo được gỡ, ưu tiên chữ của khách"},
        "nguon_noi_lo": {"enum": ["cau_hoi_khach", "doi_tuong", "chu_de"]},
        "dinh_dang": {"type": "string", "minLength": 1, "description": "Mã trong dinh-dang.yaml"},
        "goc_ke": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 5}},
        "goc_chon": {"type": "integer", "minimum": 1, "maximum": 3},
        "ly_do_goc": {"type": "string", "minLength": 5},
        "hook_chon": {"$ref": "#/$defs/hook"},
        "ly_do_hook": {"type": "string", "minLength": 5},
        "phuong_an_hook": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/hook"},
                           "description": "4 hook còn lại, giữ để thử sau"},
        "ban_1": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "loi"],
          "properties": {"id": {"type": "string", "pattern": "^s[0-9]+$"}, "loi": {"type": "string"}}}},
        "sua_ban_2": {"type": "array", "items": {"type": "string"}, "description": "Đã sửa gì sau khi đọc to bản 1"}
      }
    },
    "quyet_dinh": {
      "type": "array",
      "description": "Các quyết định agent tự đưa ra (không hỏi người), ghi vào decision_log",
      "items": {"type": "object", "required": ["category", "subject", "selected", "reason"],
                "properties": {"category": {"type": "string"}, "subject": {"type": "string"}, "selected": {"type": "string"},
                               "reason": {"type": "string"}, "options_considered": {"type": "array"}}}
    }
  }
}
